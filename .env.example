# ==========================================
# Miko Discord Music Bot - Environment Setup
# ==========================================

# Discord Bot Token (from Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application / Client ID (from General Information > Application ID)
CLIENT_ID=your_application_client_id_here

# Web Dashboard Port (default: 3000)
PORT=3000

# Optional: Spotify API Credentials for Enhanced Search
# Get these from Spotify Developer Dashboard: https://developer.spotify.com/dashboard
# Can also be entered and saved directly within the Web Dashboard Tools tab.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
